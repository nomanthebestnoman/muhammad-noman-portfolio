<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="100%" height="100%">
  <defs>
    <linearGradient id="hBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#050816"/>
      <stop offset="50%" stop-color="#0b1120"/>
      <stop offset="100%" stop-color="#050816"/>
    </linearGradient>
    <linearGradient id="hGlow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00e5ff"/>
      <stop offset="100%" stop-color="#8b5cf6"/>
    </linearGradient>
  </defs>

  <rect width="1200" height="630" fill="url(#hBg)"/>

  <polygon points="200,100 300,160 300,280 200,340 100,280 100,160" fill="rgba(11,17,32,0.9)" stroke="url(#hGlow)" stroke-width="4"/>
  <text x="200" y="235" font-family="'Space Grotesk', sans-serif" font-weight="800" font-size="70" fill="url(#hGlow)" text-anchor="middle">MN</text>

  <text x="360" y="200" font-family="'Space Grotesk', sans-serif" font-weight="800" font-size="52" fill="#ffffff">MUHAMMAD NOMAN</text>
