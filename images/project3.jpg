<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="p3Bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#050816"/>
      <stop offset="100%" stop-color="#111827"/>
    </linearGradient>
    <linearGradient id="p3Glow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00e5ff"/>
      <stop offset="50%" stop-color="#22d3ee"/>
      <stop offset="100%" stop-color="#8b5cf6"/>
    </linearGradient>
  </defs>

  <rect width="800" height="500" fill="url(#p3Bg)"/>

  <!-- Web3 Wallet Container -->
  <rect x="60" y="40" width="680" height="420" rx="20" fill="rgba(11, 17, 32, 0.95)" stroke="rgba(0, 229, 255, 0.3)" stroke-width="2"/>
  
  <rect x="90" y="70" width="300" height="150" rx="16" fill="url(#p3Glow)"/>
  <text x="120" y="105" font-family="'Poppins', sans-serif" font-weight="600" font-size="14" fill="#050816">Total Asset Portfolio</text>
  <text x="120" y="150" font-family="'Space Grotesk', sans-serif" font-weight="800" font-size="34" fill="#050816">$84,920.50</text>
  <text x="120" y="185" font-family="'Poppins', sans-serif" font-weight="700" font-size="13" fill="#050816">↗ +24.8% This Month</text>

  <rect x="420" y="70" width="290" height="150" rx="16" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.1)"/>
  <text x="440" y="105" font-family="'Poppins', sans-serif" font-size="13" fill="#94a3b8">Quick Actions</text>
  
  <rect x="440" y="125" width="70" height="40" rx="8" fill="rgba(0,229,255,0.2)"/>
  <text x="475" y="150" font-family="'Poppins', sans-serif" font-weight="700" font-size="12" fill="#00e5ff" text-anchor="middle">Send</text>

  <rect x="525" y="125" width="70" height="40" rx="8" fill="rgba(139,92,246,0.2)"/>
  <text x="560" y="150" font-family="'Poppins', sans-serif" font-weight="700" font-size="12" fill="#8b5cf6" text-anchor="middle">Receive</text>

  <rect x="610" y="125" width="80" height="40" rx="8" fill="rgba(34,211,238,0.2)"/>
  <text x="650" y="150" font-family="'Poppins', sans-serif" font-weight="700" font-size="12" fill="#22d3ee" text-anchor="middle">Swap</text>

  <!-- Candlestick / Area Chart -->
  <path d="M 90 380 L 180 320 L 260 350 L 360 280 L 460 310 L 580 250 L 700 220" fill="none" stroke="url(#p3Glow)" stroke-width="4"/>
  <circle cx="700" cy="220" r="7" fill="#00e5ff"/>

  <text x="400" y="420" font-family="'Space Grotesk', sans-serif" font-weight="700" font-size="14" fill="#00e5ff" text-anchor="middle">⚡ KRYPTON WEB3 ASSET MANAGEMENT &amp; FIGMA DESIGN SYSTEM</text>
</svg>
