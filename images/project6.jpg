<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="p6Bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#050816"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>
    <linearGradient id="p6Glow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00e5ff"/>
      <stop offset="100%" stop-color="#8b5cf6"/>
    </linearGradient>
  </defs>

  <rect width="800" height="500" fill="url(#p6Bg)"/>
  <rect x="50" y="40" width="700" height="420" rx="20" fill="rgba(11, 17, 32, 0.95)" stroke="rgba(0, 229, 255, 0.4)" stroke-width="2"/>

  <!-- Code Editor Window -->
  <rect x="80" y="80" width="640" height="280" rx="12" fill="#090d1a" stroke="rgba(255,255,255,0.1)"/>
  
  <text x="110" y="120" font-family="monospace" font-size="14" fill="#8b5cf6">const <tspan fill="#00e5ff">vortexAI</tspan> = new GeminiCodeAssistant();</text>
  <text x="110" y="150" font-family="monospace" font-size="14" fill="#94a3b8">async function generateApp(prompt) {</text>
  <text x="140" y="180" font-family="monospace" font-size="14" fill="#22d3ee">const response = await vortexAI.completeCode({ prompt });</text>
  <text x="140" y="210" font-family="monospace" font-size="14" fill="#4ade80">return response.buildOutput(); // Zero Errors</text>
  <text x="110" y="240" font-family="monospace" font-size="14" fill="#94a3b8">}</text>

  <rect x="110" y="270" width="300" height="40" rx="8" fill="url(#p6Glow)"/>
  <text x="260" y="295" font-family="'Space Grotesk', sans-serif" font-weight="700" font-size="13" fill="#050816" text-anchor="middle">⚡ GENERATE CODE SOLUTION NOW</text>

  <text x="400" y="410" font-family="'Space Grotesk', sans-serif" font-weight="700" font-size="14" fill="#00e5ff" text-anchor="middle">🤖 VORTEX AI IDE &amp; REAL-TIME MONACO CODE EDITOR</text>
</svg>
